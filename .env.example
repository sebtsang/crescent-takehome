# Copy to .env.local. Never commit .env.local.

# Set automatically by `npx convex dev`.
NEXT_PUBLIC_CONVEX_URL=

# ── Assistant credentials ────────────────────────────────────────────────────
#
# These do NOT go in this file, and this is a deliberate deviation from
# README.md, which says to put the API key in .env.local.
#
# The assistant runs in a Convex ACTION (convex/agent/chat.ts), which executes on
# Convex's servers. `process.env` inside it resolves against the Convex
# deployment, not against this machine, so a key in .env.local is invisible to
# it. Set it on the deployment instead:
#
#     npx convex env set ANTHROPIC_API_KEY <key>
#
# Verify with `npx convex env list`. The assistant logs which credential
# answered: `[assistant] auth mode: api_key`.
#
# Optional, LOCAL DEVELOPMENT ONLY:
#
#     npx convex env set ANTHROPIC_AUTH_TOKEN <token from `claude setup-token`>
#
# Draws on a Claude subscription rather than API credits. Checked BEFORE the API
# key, so it is an explicit override — remove it to fall back:
#
#     npx convex env remove ANTHROPIC_AUTH_TOKEN
#
# Not an officially supported way to authenticate an application; it returned
# HTTP 429 when tried against this deployment. See NOTES.md §15.
#
# Never expose either credential to the browser. A key reachable from client
# code can be spent by anyone who opens devtools.
