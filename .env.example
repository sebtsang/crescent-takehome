# Copy to .env.local. Never commit .env.local.

# Set automatically by `npx convex dev`.
NEXT_PUBLIC_CONVEX_URL=

# ── Assistant credentials ────────────────────────────────────────────────────
# NOTE: this differs from README.md, which says to put the key in .env.local.
# That cannot work here. The agent runs in a Convex ACTION, which executes on
# Convex's servers -- process.env inside it resolves against the deployment, not
# against this machine, so a key in .env.local is invisible to it. See NOTES.md.
#
#   npx convex env set ANTHROPIC_API_KEY <key>
#
# A key reachable from client code can be spent by anyone who opens devtools.
# ANTHROPIC_API_KEY is the intended and supported configuration.
#
# Optional, local development only:
#
#   npx convex env set ANTHROPIC_AUTH_TOKEN <token from `claude setup-token`>
#
# That draws on a Claude subscription instead of API credits. It is checked
# BEFORE the API key, so setting it is an explicit override. It is not an
# officially supported way to authenticate an application and can break without
# notice -- see NOTES.md.
